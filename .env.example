# Firebase Configuration
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# Application Configuration
APP_NAME=Amélie Customer Service Chatbot
APP_VERSION=1.0.0
APP_ENVIRONMENT=development

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Admin Configuration
ADMIN_EMAIL=admin@amelie.com
ADMIN_HASH_SALT=your-unique-salt

# Security Configuration
SESSION_SECRET=your-session-secret-key
JWT_SECRET=your-jwt-secret-key

# Database Configuration (if using additional databases)
DATABASE_URL=mongodb://localhost:27017/amelie-chatbot

# Email Configuration (for contact forms)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Analytics Configuration
GOOGLE_ANALYTICS_ID=your-analytics-id

# API Rate Limiting
API_RATE_LIMIT=100
API_RATE_WINDOW=15

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Development Configuration
DEBUG=true
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500
