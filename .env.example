# ⚠️  ENVIRONMENT VARIABLES TEMPLATE ⚠️
# This is a template file with placeholder values
# Copy this file to .env and replace ALL placeholder values with your actual credentials
# 
# SECURITY WARNING: Never commit actual credentials to version control
# The .env file should be in .gitignore and kept private
#
# Environment Configuration for Amélie Customer Service Chatbot
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# Firebase Configuration - Replace with your actual Firebase project values
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Application Configuration
APP_NAME=Amélie Customer Service Chatbot
APP_VERSION=2.0.0
APP_ENVIRONMENT=production

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Admin Configuration
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_HASH_SALT=your-unique-salt-here

# Security Configuration
SESSION_SECRET=your-session-secret-key-here
JWT_SECRET=your-jwt-secret-key-here

# Database Configuration (if using additional databases)
DATABASE_URL=mongodb://localhost:27017/your-database-name

# Email Configuration (for contact forms)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# Analytics Configuration
GOOGLE_ANALYTICS_ID=your-analytics-id-here

# API Rate Limiting
API_RATE_LIMIT=100
API_RATE_WINDOW=15

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Development Configuration
DEBUG=true
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500
