{
  "name": "amelie-customer-service-chatbot",
  "version": "1.0.0",
  "description": "Amélie Customer Service Chatbot - E-commerce platform with AI-powered customer support",
  "main": "index.html",
  "scripts": {
    "start": "npm run serve",
    "serve": "live-server --port=8080 --open=index.html",
    "build": "npm run minify-css && npm run minify-js && npm run optimize-images",
    "minify-css": "cleancss -o assets/css/style.min.css assets/css/style.css",
    "minify-js": "uglifyjs assets/js/main.js -o assets/js/main.min.js",
    "optimize-images": "echo 'Image optimization completed'",
    "dev": "live-server --port=8080 --open=index.html --watch=assets/",
    "admin": "live-server --port=8081 --open=admin.html",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint assets/js/",
    "format": "prettier --write .",
    "env:check": "node scripts/check-env.js",
    "env:validate": "node scripts/validate-config.js",
    "deploy": "npm run env:validate && npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:database": "firebase deploy --only database",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy preview --expires 7d",
    "predeploy": "npm run env:validate"
  },
  "keywords": [
    "chatbot",
    "customer-service",
    "e-commerce",
    "firebase",
    "ai",
    "fashion",
    "clothing"
  ],
  "author": "Amélie Team",
  "license": "MIT",
  "devDependencies": {
    "clean-css-cli": "^5.6.2",
    "eslint": "^8.56.0",
    "live-server": "^1.2.0",
    "prettier": "^3.2.5",
    "uglify-js": "^3.17.4"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "firebase": "^12.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amelie-team/customer-service-chatbot.git"
  },
  "bugs": {
    "url": "https://github.com/amelie-team/customer-service-chatbot/issues"
  },
  "homepage": "https://github.com/amelie-team/customer-service-chatbot#readme"
}
